# Copy to relays.env (not committed) on each machine, and fill in.

# Printed by `spike-libp2p relay` on the VPS: its QUIC address.
LIBP2P_RELAY=/ip4/203.0.113.7/udp/4001/quic-v1/p2p/12D3KooW...

# The VPS's domain name, as in iroh-relay.toml.
IROH_RELAY=https://relay.example.org/

# iroh's port mapping (UPnP, PCP, NAT-PMP): on is iroh's default.
IROH_PORTMAP=on
